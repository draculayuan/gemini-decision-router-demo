# Optional configuration (copy to .env if overriding defaults).
# Do NOT commit raw API keys to version control.

# Option A (Recommended for GCP & Cloud Run): Google Cloud Secret Manager via ADC
# If GOOGLE_CLOUD_PROJECT is omitted, the active ADC / Cloud Run project is used automatically.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_API_KEY_SECRET_ID=gemini_api_key
GEMINI_API_KEY_SECRET_VERSION=latest

# Option B (Local quick-test without GCP Secret Manager):
# GEMINI_API_KEY=your-gemini-api-key
